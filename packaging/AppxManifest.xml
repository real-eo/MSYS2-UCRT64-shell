<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  IgnorableNamespaces="uap rescap com desktop4 desktop5 uap10">

  <Identity
    Name="Msys2Ucrt64Shell"
    Publisher="CN=real-eo"
    Version="1.0.0.0"
    ProcessorArchitecture="neutral" />

  <Properties>
    <DisplayName>MSYS2 UCRT64 Shell</DisplayName>
    <PublisherDisplayName>real-eo</PublisherDisplayName>
    <Logo>assets\ucrt64-2.png</Logo>
    
    <!-- ! OPTION A (sparse, active): AllowExternalContent must be true.
         ! OPTION B (full package, for when the DLL is more complete):
         !   1. Set AllowExternalContent="false"
         !   2. Copy msys2_ucrt64_shell.dll into packaging\
         !   3. Uncomment the copy step in build.bat
         !   4. Uncomment the pack/sign step in scripts\register-package.ps1
         !   5. Register with: Add-AppxPackage -Path .\packaging\Msys2Ucrt64Shell.msix
    ! -->
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="App"
      Executable="msys2_ucrt64_shell_stub.exe"
      uap10:TrustLevel="mediumIL"
      uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        AppListEntry="none"
        DisplayName="MSYS2 UCRT64 Shell"
        Description="Open folders in MSYS2 UCRT64"
        BackgroundColor="transparent"
        Square150x150Logo="assets\ucrt64-2.png"
        Square44x44Logo="assets\ucrt64-2.png" />
      <Extensions>
        <!-- Register the verb on the Windows 11 context menu -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="Msys2Ucrt64" Clsid="15A3870D-B649-4DD0-8F37-8CCDDAA99039" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="Msys2Ucrt64" Clsid="15A3870D-B649-4DD0-8F37-8CCDDAA99039" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>

        <!-- Register the DLL as a packaged COM server -->
        <com:Extension Category="windows.comServer" uap10:RuntimeBehavior="packagedClassicApp">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Context menu verb handler">
              <com:Class Id="15A3870D-B649-4DD0-8F37-8CCDDAA99039" Path="msys2_ucrt64_shell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>